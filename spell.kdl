// Spell project configuration
// Docs: https://github.com/can1357/oh-my-pi

domain "coding"
import "spell.coding.typescript"

appearance {
	// theme dark="titanium" light="light"
	// symbols "unicode"
	// color-blind #false
	// status-line preset="default" separator="powerline-thin" {
	// 	left "pi" "model" "plan_mode" "path" "git"
	// 	right "token_total" "cost" "context_pct" "time"
	// 	show-hook-status #true
	// }
	// images show-inline=#true auto-resize=#true
}

model {
	// thinking "high"
	// max-thinking-tokens 16384
	roles {
		// default "anthropic/claude-sonnet-4-20250514"
		// smol "anthropic/claude-haiku-3"
		// slow "anthropic/claude-sonnet-4-20250514"
		// task "anthropic/claude-sonnet-4-20250514"
		// commit "anthropic/claude-haiku-3"
	}
	// sampling {
	// 	temperature -1
	// 	top-p -1
	// 	top-k -1
	// 	service-tier "none"
	// }
	// retry max=3 backoff-ms=1000
	// compaction enabled=#true threshold=0.7 strategy="context-full"
}

providers {
	// provider "anthropic" {
	// 	api-key "$ANTHROPIC_API_KEY"
	// }
}

tools {
	// intent-tracing #true
	// max-timeout 0
	// bash enabled=#true
	// fetch enabled=#true
	// browser enabled=#true headless=#true
	// org enabled=#true
	// checkpoint enabled=#false
	// mcp project-config=#true discovery-mode=#false notifications=#false
	// async enabled=#false max-jobs=100
}

tasks {
	// eager #false
	// auto-roster #true
	// max-concurrency 32
	// max-recursion 2
	// max-tool-calls 200
	// cache-stagger-ms 800
	// isolation mode="none" merge="patch" commits="generic"
}

interaction {
	// steering #true
	// caveman enabled=#false level="full"
	// auto-compact #true
	context max-file-lines=2000 {
		// promotion enabled=#true target="slow"
	}
	editing {
		// auto-format #true
		// preserve-indentation #true
	}
}

keybindings {
	// interrupt "escape"
	// clear "ctrl+c"
	// exit "ctrl+d"
	// cycle-thinking-level "shift+tab"
	// cycle-model-forward "ctrl+p"
	// cycle-model-backward "shift+ctrl+p"
	// select-model "ctrl+l"

	// history-search "ctrl+r"
	// expand-tools "ctrl+o"
	// toggle-thinking "ctrl+t"
	// external-editor "ctrl+g"
	// follow-up "ctrl+enter"
	// paste-image "ctrl+v"
	// toggle-stt "alt+h"
}

skills {
	// enabled #true
	// enable-commands #true
	// custom-directories "./custom-skills"
	// ignored "voice-agent"
}

org {
	// enabled #true
	// todo-keywords "INIT" "ITEM" "DOING" "REVIEW" "DONE" "BLOCKED"
}

// Project-specific policy overrides
// The imported template provides base layers and policies.
// Policies declared here override the template by name.
policy "api-quality" layer="api" {
    gate-commit #true
    gate-cmd "bun run --workspaces --if-present --parallel test"
    verify-cmd "bun run --parallel check:ts check:rs"
}

policy "ui-quality" layer="ui" {
    gate-commit #true
    gate-cmd "bun run --workspaces --if-present --parallel test"
}

// FEAT-816 consumer #2: the reviewer-swarm sub-loop as a layer gate. Any todo
// node / org item on the `implementation` layer must, before completion, fan out
// 3 parallel reviewers over its diff and burn down the findings. Satisfiable by
// an already-run review of the same diff (no blind re-dispatch).
policy "implementation-swarm" layer="implementation" {
    gate-commit #true
    swarm 3 criteria="security holes · escape vectors · convention drift · leak/race · missing edges"
}


// ── Roles ── verb-titled, KDL-native. command → titlebar + /slash.
//    context-policy: carry = re-inject every turn · fresh = once on activation
//    tools rosters below are commented placeholders — tune later; omitted = full default set

mode "orchestrate" {
	command "/orchestrate"
	description "Own architecture; reviewer swarms discover→fix; waves absorb fallout"
	context-policy "carry"
	// tools { allow "find" "get" "edit" "create" "bash" "task" "org" "todo_write" "lsp" }
	context """
	Main thread owns architecture. Reviewer swarms own discovery→fix. New waves absorb fallout.
	depth > speed · verification > momentum · run independently to the end of the agreed plan.
	"""
	instructions """
	per wave:
	  spine   → main thread lands load-bearing types/contracts/protocol — one head ∴ globally coherent
	  review  → fan ∥ reviewers at the landed wave; they SURFACE (report_finding), ✗ silent-fix
	  triage  → main thread: each finding → org BUG/FEAT + severity
	  fix     → scoped/mechanical → task swarm (file-disjoint, ≤5 files) ; architectural → main thread
	  gate    → wave ✗done until: proof green ∧ review backlog burned. fallout heavy → insert W_n.5 hardening
	report → after every wave/subwave, in chat: landed · review found · next. then continue.
	∴ yield at end of plan, or when scope exhausted — never mid-wave.
	"""
}

mode "discover" {
	command "/discover"
	description "Map the architecture — layers, boundaries, data flow, extension points"
	read-only #true
	context-policy "fresh"
	// tools { allow "find" "get" "bash" "lsp" "fetch" "code_search" }
	context """
	Goal: a map of the system, not a fix. How is it built, where are the seams, what is load-bearing.
	Read-only.
	"""
	instructions """
	trace → layers ∧ boundaries · who owns what · which abstraction carries the weight
	follow → def→ ref→ call→ import→ ; data flow end-to-end, not file-by-file
	find → existing patterns · DSLs · extension points a new feature would slot into
	name → the invariants the architecture rests on, and where they'd break under change
	∄ edits · ∄ premature design
	∴ output = architecture map · seams · load-bearing pieces · extension points (path:line)
	"""
}

mode "challenge" {
	command "/challenge"
	description "Refine understanding — surface ambiguity, assumptions, unscoped edges"
	read-only #true
	context-policy "fresh"
	// tools { allow "find" "get" "ask" "lsp" }
	context """
	Refine understanding before work commits. Q the request, ✗ the solution.
	"""
	instructions """
	probe → hidden intent? unstated constraints? undefined terms ("fast","clean","simple")?
	        branching unsaid? acceptance unverifiable? error-handling unspecified?
	each gap → one concrete `ask` (batch them) · ✗ guessing · ✗ premature design
	∴ exit when scope ∧ acceptance ∧ error-handling are settled.
	"""
}

// Tool-disciplines (e.g. "mock-critique" for generate_ui_screen) ship as BUNDLED
// defaults in config/bundled-disciplines.kdl — available in every repo. Declare a
// project `discipline "name" { … }` block here only to add or override one.

mode "design" {
	command "/design"
	description "Propose form — UI/UX direction, mockups, interaction shape"
	context-policy "carry"
	// tools { allow "find" "get" "generate_ui_screen" "generate_image" "canvas" "browser" "fetch" "web_search" }
	context """
	Goal: propose form before build. Direction → mockup → critique loop.
	Distinct over derivative; resist convergence to the obvious.
	"""
	instructions """
	frame → who · what job · what state (empty/loaded/error) · what one feeling it must land
	survey → existing tokens/components in repo · ✗ reinvent what the system already owns
	propose → one direction w/ rationale, then mock it (generate_ui_screen / canvas)
	critique → against frame: legible? respects the user's time? ✗ flash over substance
	∴ iterate direction→mock→critique until the frame is satisfied, then hand to orchestrate.
	"""
}

