{
	"type": "module",
	"name": "@spell/pi-utils",
	"version": "13.12.8",
	"description": "Shared utilities for pi packages",
	"homepage": "https://github.com/timinou/spell",
	"author": "Can Boluk",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timinou/spell.git",
		"directory": "packages/utils"
	},
	"bugs": {
		"url": "https://github.com/timinou/spell/issues"
	},
	"keywords": [
		"utilities",
		"cli",
		"logging",
		"streams"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"beautiful-mermaid": "^1.1",
		"winston": "^3.19",
		"winston-daily-rotate-file": "^5.0"
	},
	"devDependencies": {
		"@spell/pi-natives": "workspace:*",
		"@types/bun": "^1.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
