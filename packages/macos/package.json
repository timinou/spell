{
	"type": "module",
	"name": "@spell/pi-macos",
	"version": "0.1.0",
	"description": "macOS desktop integration for spell (menu bar, overlay, Hammerspoon)",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "tsgo -p tsconfig.json"
	},
	"dependencies": {
		"@spell/pi-desktop-common": "workspace:*",
		"@spell/pi-qml": "workspace:*",
		"@spell/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src",
		"qml"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
