{
	"type": "module",
	"name": "@spell/spell-deploy",
	"version": "0.1.0",
	"description": "Remote deployment and sync for spell-server",
	"homepage": "https://github.com/timinou/spell",
	"author": "Can Boluk",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timinou/spell.git",
		"directory": "packages/spell-deploy"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"spell-deploy": "./src/cli/main.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@bgotink/kdl": "^0.4",
		"@spell/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
