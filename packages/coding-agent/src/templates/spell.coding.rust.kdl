layer "core" description="Core library and business logic"
layer "api" description="Service boundaries and integration points"
layer "cli" description="Command-line interfaces and binaries"

policy "core-quality" layer="core" {
    verify-commit #true
    verify-cmd "cargo test"
}

policy "api-quality" layer="api" {
    verify-commit #true
    verify-cmd "cargo clippy -- -D warnings && cargo test"
}

policy "cli-quality" layer="cli" {
    verify-commit #true
}
