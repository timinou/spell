{
	"type": "module",
	"name": "@oh-my-pi/telegram-bridge",
	"version": "0.1.0",
	"description": "Telegram bridge for Spell coding agent",
	"homepage": "https://github.com/can1357/oh-my-pi",
	"author": "Can Boluk",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/telegram-bridge"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"telegram-bridge": "./src/index.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test",
		"start": "bun run src/index.ts"
	},
	"dependencies": {
		"grammy": "^1.35",
		"yaml": "^2.7",
		"qrcode": "^1.5",
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/qrcode": "^1.5"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
