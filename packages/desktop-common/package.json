{
	"type": "module",
	"name": "@spell/pi-desktop-common",
	"version": "0.1.0",
	"description": "Shared desktop integration types and logic for spell (status files, snapshots, colors)",
	"homepage": "https://github.com/timinou/spell",
	"author": "Can Boluk",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timinou/spell.git",
		"directory": "packages/desktop-common"
	},
	"bugs": {
		"url": "https://github.com/timinou/spell/issues"
	},
	"keywords": [
		"desktop",
		"status",
		"overlay",
		"systray"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "tsgo -p tsconfig.json"
	},
	"dependencies": {
		"@spell/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
