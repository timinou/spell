{
	"type": "module",
	"name": "@spell/spell-team-chat",
	"version": "0.1.0",
	"private": true,
	"description": "Spell Team Chat \u2014 multiplayer Svelte UI served by spell-server",
	"homepage": "https://github.com/timinou/spell",
	"license": "GPL-3.0-only",
	"bin": {
		"spell-team-chat": "./bin/spell-team-chat.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview --port 5175",
		"check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
		"start": "bun run bin/spell-team-chat.ts",
		"test": "bun test test/ --timeout 120000",
		"test:unit": "bun test test/unit/",
		"test:e2e": "bun test test/e2e/ --timeout 120000"
	},
	"dependencies": {
		"@spell/spell-server": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tsconfig/svelte": "^5.0.4",
		"svelte": "^5.20.0",
		"svelte-check": "^4.1.4",
		"typescript": "^5.7.3",
		"vite": "^6.0.0",
		"playwright": "^1.49.0"
	},
	"files": [
		"src",
		"bin",
		"dist",
		"index.html",
		"svelte.config.js",
		"vite.config.ts",
		"tsconfig.json"
	]
}
