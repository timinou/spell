{
	"type": "module",
	"name": "@spell/pi-tui",
	"version": "13.12.8",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"homepage": "https://github.com/timinou/spell",
	"author": "Can Boluk",
	"contributors": [
		"Mario Zechner"
	],
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timinou/spell.git",
		"directory": "packages/tui"
	},
	"bugs": {
		"url": "https://github.com/timinou/spell/issues"
	},
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test test/*.test.ts"
	},
	"dependencies": {
		"@spell/pi-natives": "workspace:*",
		"@spell/pi-utils": "workspace:*",
		"marked": "^17.0"
	},
	"devDependencies": {
		"chalk": "^5.6",
		"@xterm/headless": "^6.0"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		},
		"./components/*": {
			"types": "./src/components/*.ts",
			"import": "./src/components/*.ts"
		}
	}
}
