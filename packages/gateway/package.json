{
	"type": "module",
	"name": "@spell/pi-gateway",
	"version": "0.1.0",
	"description": "Local reverse proxy and service gateway for Spell",
	"homepage": "https://github.com/timinou/spell",
	"author": "Can Boluk",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/timinou/spell.git",
		"directory": "packages/gateway"
	},
	"bugs": {
		"url": "https://github.com/timinou/spell/issues"
	},
	"keywords": [
		"gateway",
		"proxy",
		"reverse-proxy",
		"localhost",
		"tls"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@spell/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
