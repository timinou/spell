// Spell brand typography
// Inter is used for headings and body; JetBrains Mono for code.
// Falls back gracefully if the system font is unavailable.

#let heading-font = ("Inter", "Helvetica Neue", "Arial", "sans-serif")
#let body-font = ("Inter", "Helvetica Neue", "Arial", "sans-serif")
#let mono-font = ("JetBrains Mono", "Fira Code", "Courier New", "monospace")

// Heading sizes
#let h1-size = 24pt
#let h2-size = 18pt
#let h3-size = 14pt

// Body sizes
#let body-size = 11pt
#let small-size = 9pt
