;; reducibility estimate (PLAN-018, L2-corrected) — a CHEAP analysis, NOT a
;; reduction.
;;
;; Answers "how much could the LOSSY tier shed from the replayed wire tape, and is
;; it worth a keyframe?" WITHOUT performing any reduction and WITHOUT inference.
;; The rate-controller (W5) reads this to decide reduce-vs-cache.
;;
;; THE CONTRACT (L2 cost-proof): the estimate must agree with what Spill.spill/2
;; actually sheds, or K* is computed on the wrong byte set. Spill replaces a
;; node.result with a tiny stub IFF the node is RESTORABLE (a pure-:read node, the
;; "restorable" projection flag) AND its rendered result exceeds the spill
;; threshold (~512 tokens). So the shed estimate is: for each spillable node, its
;; result tokens minus the small stub cost. Non-restorable, failed, or
;; below-threshold results shed NOTHING (Spill keeps them verbatim).
;;
;; Returns:
;;   {"tok_full"          F   ; est tokens of the full refolded tape (form_src + result)
;;    "tok_reduced"       R   ; est tokens after the lossy spill
;;    "reducible_tokens"  F-R
;;    "nodes"             N}

(let [nodes data/nodes

      ;; spill threshold in TOKENS (mirrors Spill @default_threshold_tokens 512).
      threshold 512
      ;; a spilled stub costs ~a few tokens; charge a flat 32 so the estimate is a
      ;; slight under-promise rather than over-promise.
      stub-tokens 32

      est-tokens (fn [s]
                   (if (and (string? s) (> (count s) 0))
                     (max 1 (quot (count s) 4))
                     0))

      result-tokens (fn [n] (est-tokens (json/generate-string (get n "result"))))
      form-tokens   (fn [n] (est-tokens (get n "form_src")))

      ;; nodes that emit a program turn on the wire AND succeeded.
      wire-nodes (filter (fn [n]
                           (and (string? (get n "form_src"))
                                (> (count (get n "form_src")) 0)
                                (= (get n "status") "ok")))
                         nodes)

      tok-full (reduce (fn [a n] (+ a (form-tokens n) (result-tokens n))) 0 wire-nodes)

      ;; a node is SPILLABLE exactly as Spill.spillable? judges it: restorable +
      ;; over the token threshold. Its shed = result tokens minus the stub cost.
      spill-shed (reduce (fn [a n]
                           (let [rt (result-tokens n)]
                             (if (and (get n "restorable") (> rt threshold))
                               (+ a (max 0 (- rt stub-tokens)))
                               a)))
                         0
                         wire-nodes)

      reducible (min (max 0 spill-shed) tok-full)
      tok-reduced (max 0 (- tok-full reducible))]

  {"tok_full" tok-full
   "tok_reduced" tok-reduced
   "reducible_tokens" reducible
   "nodes" (count nodes)})
