;; reducibility estimate (PLAN-018 W3, corrected per L1 audit) — a CHEAP analysis,
;; NOT a reduction.
;;
;; Answers "how much could shedding remove from the REPLAYED WIRE TAPE, and is it
;; worth a keyframe?" WITHOUT performing any reduction and WITHOUT any inference.
;; The rate-controller (W5) reads this every turn to decide reduce-vs-cache.
;;
;; WIRE MODEL (the L1 correction): in tool_call mode the refolded tape emits, per
;; node, the program text (`form_src`) + the program RESULT (`result`). The `sees`
;; (inner tool calls) and `prints` never reach the wire. So the estimate counts
;; what sheds from `form_src` + `result`, NOT the sees-level CSE — otherwise the
;; controller would decide on bytes that are not actually on the feed.
;;
;; Returns:
;;   {"tok_full"          F   ; est tokens of the full refolded tape (form_src + result)
;;    "tok_reduced"       R   ; est tokens after shedding duplicate/superseded results
;;    "reducible_tokens"  F-R ; the shed estimate (>= 0)
;;    "nodes"             N}  ; nodes considered
;;
;; Token estimate mirrors the runtime len/4 rule (Metrics.estimate_tokens).
;; Two inference-free shed signals over `node.result`:
;;   * result-CSE           : identical (form_src, result) — same program, same
;;                            bytes; each copy beyond the first sheds its result.
;;   * stale-result-collapse: same read program (form_src) re-run; earlier results
;;                            shed, last kept. The Elixir reducer applies the
;;                            effect-class gate; the estimate is a signal, not a
;;                            contract, and never exceeds tok_full.
;; Errors are exempt: a node whose status is "error" never sheds its result.

(let [nodes data/nodes

      est-tokens (fn [s]
                   (if (and (string? s) (> (count s) 0))
                     (max 1 (quot (count s) 4))
                     0))

      result-tokens (fn [n] (est-tokens (json/generate-string (get n "result"))))
      form-tokens   (fn [n] (est-tokens (get n "form_src")))

      wire-nodes (filter (fn [n]
                           (and (string? (get n "form_src"))
                                (> (count (get n "form_src")) 0)
                                (= (get n "status") "ok")))
                         nodes)

      tok-full (reduce (fn [a n] (+ a (form-tokens n) (result-tokens n))) 0 wire-nodes)

      ;; stale-result-collapse subsumes result-CSE (same form_src is coarser than
      ;; same form_src+result), so it is the dominant shed signal: a group of k
      ;; same-program nodes sheds the result tokens of all but the LAST.
      by-form (group-by (fn [n] (get n "form_src")) wire-nodes)
      stale-shed (reduce (fn [a [_k ns]]
                           (if (> (count ns) 1)
                             (let [butlast (take (- (count ns) 1) ns)]
                               (+ a (reduce (fn [b n] (+ b (result-tokens n))) 0 butlast)))
                             a))
                         0
                         by-form)

      reducible (min (max 0 stale-shed) tok-full)
      tok-reduced (max 0 (- tok-full reducible))]

  {"tok_full" tok-full
   "tok_reduced" tok-reduced
   "reducible_tokens" reducible
   "nodes" (count nodes)})
